# Supabase (proyecto ipnqyejdfcwcltutrrvh)
NEXT_PUBLIC_SUPABASE_URL="https://ipnqyejdfcwcltutrrvh.supabase.co"

# Secret API key (server only). Enough for PostgREST: users, reports, parcels, snapshots.
# Never expose this as NEXT_PUBLIC_*. On Vercel set it as a private env var.
SUPABASE_SECRET_KEY=""

# Optional: Postgres URI from Supabase → Settings → Database (Prisma migrations / direct SQL).
# Prefer the session pooler (port 5432). Direct db.*.supabase.co is IPv6-only.
# DATABASE_URL="postgresql://postgres.ipnqyejdfcwcltutrrvh:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Upstash Redis (Edge rate limit on /api). Without these, the API fail-opens (no limit).
# Same region as the Vercel project. Never prefix with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
